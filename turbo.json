{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "ROOT_DOMAIN",
        "AUTH_CENTRAL_HOST",
        "UNIVERSITY_HOST_SLUG_MAP",
        "STUDENT_ROOT_DOMAIN",
        "ADMIN_ROOT_DOMAIN",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "R2_ENDPOINT",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "CINETPAY_API_KEY",
        "CINETPAY_SITE_ID",
        "PAYMENT_WEBHOOK_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "ROOT_DOMAIN",
        "AUTH_CENTRAL_HOST",
        "UNIVERSITY_HOST_SLUG_MAP",
        "STUDENT_ROOT_DOMAIN",
        "ADMIN_ROOT_DOMAIN",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "R2_ENDPOINT",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET_NAME",
        "CINETPAY_API_KEY",
        "CINETPAY_SITE_ID",
        "PAYMENT_WEBHOOK_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    }
  }
}
