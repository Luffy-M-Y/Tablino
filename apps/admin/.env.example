# Université active (serveur uniquement — jamais NEXT_PUBLIC_)
UNIVERSITY_ID=<uuid-de-l-universite>

# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/tablino

# Next Auth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STUDENT_ROOT_DOMAIN=localhost:3000
# Domaine parent des hôtes admin ; sa racine est réservée au futur site vitrine.
# super_admin : sup-admin.<ADMIN_ROOT_DOMAIN> ; admins d'université : {slug}-admin.<ADMIN_ROOT_DOMAIN>.
ADMIN_ROOT_DOMAIN=localhost:3001
AUTH_ADMIN_CENTRAL_HOST=

# Carte hôte→slug pour la résolution d'hôte admin (JSON optionnel)
# Format : {"iscom": "iscom", "uji": "uji"}
ADMIN_HOST_SLUG_MAP=

# Cloudflare R2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tablino-docs

# Paiement (côté serveur uniquement)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
PAYMENT_WEBHOOK_SECRET=

# Brevo (e-mails)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
