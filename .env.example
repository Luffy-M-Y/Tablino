# Domaine racine des sous-domaines universitaires (serveur uniquement)
ROOT_DOMAIN=localhost:3000
UNIVERSITY_HOST_SLUG_MAP={"short-host-slug":"existing-university-slug"}

# Identifiant de l'université active pour apps/admin (serveur uniquement — jamais NEXT_PUBLIC_)
UNIVERSITY_ID=<uuid-de-l-universite>

# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/tablino

# Next Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tablino-docs

# Paiement (côté serveur uniquement)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
PAYMENT_WEBHOOK_SECRET=
